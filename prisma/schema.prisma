generator client {
	provider = "prisma-client"
	output   = "../generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum Role {
	CUSTOMER
	ADMIN
	SUPER_ADMIN
}

enum ReservationStatus {
	PENDING
	CONFIRMED
	CANCELLED_BY_CUSTOMER
	CANCELLED_BY_ADMIN
	COMPLETED
	NO_SHOW
}

enum PaymentStatus {
	NONE
	PENDING
	PAID
	REFUNDED
	PARTIALLY_REFUNDED
	FAILED
}

enum PaymentType {
	DEPOSIT
	FULL
	NONE
}

enum InvoiceType {
	DEPOSIT
	ADDITION
}

enum OfferTarget {
	ALL
	REGISTERED
	SPECIFIC
}

enum OfferType {
	PERCENTAGE
	FIXED_AMOUNT
	FREE_ITEM
}

enum GalleryCategory {
	DINING_ROOM
	DISHES
	EVENTS
	TEAM
	EXTERIOR
}

enum EventStatus {
	NEW
	IN_PROGRESS
	ACCEPTED
	DECLINED
}

enum ZoneTable {
	SALLE
	TERRASSE
	BAR
	PRIVE
}

enum ServiceStatus {
	OUVERTE
	ADDITION_DEMANDEE
	PAYEE
	ANNULEE
}

enum ServiceType {
	RESERVATION
	WALK_IN
}

enum PaymentMethodService {
	CB
	ESPECES
	CHEQUE
	TICKET_RESTO
}

enum CourseType {
	ENTREE
	PLAT
	DESSERT
	BOISSON
	EXTRA
}

model User {
	id                      String                   @id @default(cuid())
	email                   String                   @unique
	emailVerified           DateTime?
	passwordHash            String
	firstName               String
	lastName                String
	phone                   String?
	avatarUrl               String?
	avatarPublicId          String?
	dietaryPreferences      String[]
	role                    Role                     @default(CUSTOMER)
	isActive                Boolean                  @default(true)
	createdAt               DateTime                 @default(now())
	updatedAt               DateTime                 @updatedAt
	reservations            Reservation[]
	invoices                Invoice[]
	passwordResetTokens     PasswordResetToken[]
	emailVerificationTokens EmailVerificationToken[]
	specialOfferTargets     SpecialOfferTarget[]
	@@index([email])
	@@map("users")
}

model Admin {
	id                 String    @id @default(cuid())
	username           String    @unique
	passwordHash       String
	role               Role      @default(ADMIN)
	mustChangePassword Boolean   @default(true)
	lastLoginAt        DateTime?
	createdAt          DateTime  @default(now())
	updatedAt          DateTime  @updatedAt
	@@map("admins")
}

model MenuCategory {
	id          String   @id @default(cuid())
	name        String
	slug        String   @unique
	description String?
	iconName    String?
	order       Int      @default(0)
	isActive    Boolean  @default(true)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	dishes      Dish[]
	@@map("menu_categories")
}

model Image {
	id        String   @id @default(cuid())
	url       String
	publicId  String
	alt       String?
	isPrimary Boolean  @default(false)
	order     Int      @default(0)
	createdAt DateTime @default(now())

	dishId    String?
	dish      Dish?    @relation(fields: [dishId], references: [id], onDelete: Cascade)

	@@index([dishId])
	@@map("images")
}

model Dish {
	id              String             @id @default(cuid())
	categoryId      String
	name            String
	slug            String             @unique
	description     String?
	price           Float
	imageUrl        String?
	imagePublicId   String?
	allergens       String[]
	dietaryTags     String[]
	isAvailable     Boolean            @default(true)
	isDailySpecial  Boolean            @default(false)
	order           Int                @default(0)
	createdAt       DateTime           @default(now())
	updatedAt       DateTime           @updatedAt
	category        MenuCategory       @relation(fields: [categoryId], references: [id])
	images          Image[]
	specialOfferItems SpecialOfferItem[]
	serviceOrderItems ServiceOrderItem[]
	@@index([categoryId])
	@@index([isAvailable])
	@@map("dishes")
}

model Reservation {
	id                  String            @id @default(cuid())
	userId              String?
	guestFirstName      String
	guestLastName       String
	guestEmail          String
	guestPhone          String
	date                DateTime          @db.Date
	timeSlot            String
	covers              Int
	notes               String?
	allergies           String?
	status              ReservationStatus @default(PENDING)
	cancellationReason  String?
	cancelledAt         DateTime?
	confirmedAt         DateTime?
	completedAt         DateTime?
	autoCancelDeadline DateTime?
	createdAt           DateTime          @default(now())
	updatedAt           DateTime          @updatedAt

	tableId             String?
	table               Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
	tableAssignedAt     DateTime?

	occasion            String?

	adminNotes          String?

	user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
	payment             Payment?
	invoices            Invoice[]
	serviceOrder        ServiceOrder?

	@@index([date, status])
	@@index([userId])
	@@index([guestEmail])
	@@index([autoCancelDeadline])
	@@index([tableId])
	@@map("reservations")
}

model Table {
	id           String         @id @default(cuid())
	numero       Int            @unique
	capaciteMin  Int            @default(1)
	capaciteMax  Int
	zone         ZoneTable      @default(SALLE)
	description  String?
	positionX    Float?         @default(0)
	positionY    Float?         @default(0)
	isActif      Boolean        @default(true)
	createdAt    DateTime       @default(now())
	updatedAt    DateTime       @updatedAt

	reservations Reservation[]
	blocages     TableBlocage[]
	serviceOrders ServiceOrder[]

	@@map("tables")
}

model TableBlocage {
	id         String   @id @default(cuid())
	tableId    String
	table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
	date       DateTime @db.Date
	heureDebut String
	heureFin   String
	motif      String?
	createdAt  DateTime @default(now())

	@@index([tableId, date])
	@@map("table_blocages")
}

model Payment {
	id                    String        @id @default(cuid())
	reservationId         String        @unique
	stripePaymentIntentId String?       @unique
	stripeChargeId        String?
	amount                Float
	currency              String        @default("eur")
	type                  PaymentType   @default(DEPOSIT)
	status                PaymentStatus @default(NONE)
	refundedAmount        Float?
	stripeRefundId        String?
	paidAt                DateTime?
	refundedAt            DateTime?
	failureReason         String?
	createdAt             DateTime      @default(now())
	updatedAt             DateTime      @updatedAt
	reservation           Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
	invoice               Invoice?
	@@index([status])
	@@map("payments")
}

model InvoiceTemplate {
	id             String      @id @default(cuid())
	name           String
	type           InvoiceType
	isActive       Boolean     @default(false)

	cloudinaryUrl      String
	cloudinaryPublicId String

	createdAt      DateTime    @default(now())
	updatedAt      DateTime    @updatedAt

	invoices       Invoice[]

	@@index([type])
	@@index([type, isActive])
	@@map("invoice_templates")
}

model Invoice {
	id             String       @id @default(cuid())
	invoiceNumber  String       @unique
	type           InvoiceType  @default(DEPOSIT)

	paymentId      String?      @unique
	payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

	serviceOrderId String?      @unique
	serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

	reservationId  String?
	reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

	userId         String?
	user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

	templateId     String?
	template       InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

	guestEmail     String?
	guestName      String?

	amount         Float
	taxAmount      Float        @default(0)
	totalAmount    Float
	pdfUrl         String?
	pdfPublicId    String?
	issuedAt       DateTime     @default(now())
	createdAt      DateTime     @default(now())
	updatedAt      DateTime     @updatedAt

	@@index([userId])
	@@index([reservationId])
	@@index([type])
	@@index([templateId])
	@@map("invoices")
}

model ServiceOrder {
	id              String               @id @default(cuid())
	tableId         String
	reservationId   String?              @unique
	type            ServiceType
	status          ServiceStatus        @default(OUVERTE)
	guestName       String
	covers          Int
	notes           String?
	paymentMethod   PaymentMethodService?
	depositDeducted Float                @default(0)
	totalAmount     Float                @default(0)
	openedAt        DateTime             @default(now())
	closedAt        DateTime?
	createdAt       DateTime             @default(now())
	updatedAt       DateTime             @updatedAt

	table           Table                @relation(fields: [tableId], references: [id])
	reservation     Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
	items           ServiceOrderItem[]
	invoice         Invoice?

	@@index([tableId, status])
	@@index([status])
	@@map("service_orders")
}

model ServiceOrderItem {
	id          String       @id @default(cuid())
	orderId     String
	dishId      String
	dishName    String
	unitPrice   Float
	qty         Int          @default(1)
	totalPrice  Float
	notes       String?
	course      CourseType   @default(PLAT)
	createdAt   DateTime     @default(now())
	updatedAt   DateTime     @updatedAt

	order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
	dish        Dish         @relation(fields: [dishId], references: [id])

	@@index([orderId])
	@@map("service_order_items")
}

model SpecialOffer {
	id          String               @id @default(cuid())
	title       String
	description String?
	type        OfferType
	value       Float
	target      OfferTarget          @default(ALL)
	promoCode   String?              @unique
	minCovers   Int?
	isFirstOnly Boolean              @default(false)
	isPublic    Boolean              @default(true)
	startDate   DateTime
	endDate     DateTime
	isActive    Boolean              @default(true)
	createdAt   DateTime             @default(now())
	updatedAt   DateTime             @updatedAt
	items       SpecialOfferItem[]
	targets     SpecialOfferTarget[]
	@@map("special_offers")
}

model SpecialOfferItem {
	id             String       @id @default(cuid())
	specialOfferId String
	dishId         String
	specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)
	dish           Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
	@@unique([specialOfferId, dishId])
	@@map("special_offer_items")
}

model SpecialOfferTarget {
	id             String       @id @default(cuid())
	specialOfferId String
	userId         String
	specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)
	user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@unique([specialOfferId, userId])
	@@map("special_offer_targets")
}

model ScheduleDay {
	id        String   @id @default(cuid())
	dayOfWeek Int
	isOpen    Boolean  @default(true)
	slots     Json
	updatedAt DateTime @updatedAt
	@@unique([dayOfWeek])
	@@map("schedule_days")
}

model ClosedDay {
	id        String   @id @default(cuid())
	date      DateTime @db.Date
	reason    String?
	createdAt DateTime @default(now())
	@@unique([date])
	@@map("closed_days")
}

model GalleryImage {
	id         String          @id @default(cuid())
	imageUrl   String
	publicId   String
	caption    String?
	category   GalleryCategory @default(DISHES)
	order      Int             @default(0)
	isActive   Boolean         @default(true)
	uploadedAt DateTime        @default(now())
	@@map("gallery_images")
}

model EventRequest {
	id         String      @id @default(cuid())
	firstName  String
	lastName   String
	email      String
	phone      String
	eventType  String
	eventDate  DateTime?
	guestCount Int?
	budget     String?
	message    String
	status     EventStatus @default(NEW)
	adminNotes String?
	createdAt  DateTime    @default(now())
	updatedAt  DateTime    @updatedAt
	@@map("event_requests")
}

model AdminNotification {
	id        String   @id @default(cuid())
	type      String
	title     String
	message   String
	link      String?
	isRead    Boolean  @default(false)
	createdAt DateTime @default(now())
	@@map("admin_notifications")
}

model PasswordResetToken {
	id        String    @id @default(cuid())
	userId    String
	token     String    @unique
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime  @default(now())
	user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@map("password_reset_tokens")
}

model EmailVerificationToken {
	id        String    @id @default(cuid())
	userId    String
	token     String    @unique
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime  @default(now())
	user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@map("email_verification_tokens")
}

model RestaurantSettings {
	id                      String   @id @default(cuid())
	name                    String   @default("Spoon")
	tagline                 String?
	description             String?
	logoUrl                 String?
	logoPublicId            String?
	phone                   String?
	email                   String?
	address                 String?
	googleMapsUrl           String?
	facebookUrl             String?
	instagramUrl            String?
	depositRequired         Boolean  @default(true)
	depositAmountPerCover   Float    @default(20.0)
	freeCancellationHours   Int      @default(24)
	maxCoversPerSlot        Int      @default(40)
	minBookingNoticeHours   Int      @default(2)
	maxBookingAdvanceDays   Int      @default(60)
	autoConfirmReservations Boolean  @default(false)
	updatedAt               DateTime @updatedAt
	@@map("restaurant_settings")
}
