generator client {
	provider = "prisma-client"
	output   = "../generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum Role {
	CUSTOMER
	ADMIN
	SUPER_ADMIN
}

enum ReservationStatus {
	PENDING
	CONFIRMED
	CANCELLED_BY_CUSTOMER
	CANCELLED_BY_ADMIN
	COMPLETED
	NO_SHOW
}

enum PaymentStatus {
	NONE
	PENDING
	PAID
	REFUNDED
	PARTIALLY_REFUNDED
	FAILED
}

enum PaymentType {
	DEPOSIT
	FULL
	NONE
}

enum OfferTarget {
	ALL
	REGISTERED
	SPECIFIC
}

enum OfferType {
	PERCENTAGE
	FIXED_AMOUNT
	FREE_ITEM
}

enum GalleryCategory {
	DINING_ROOM
	DISHES
	EVENTS
	TEAM
	EXTERIOR
}

enum EventStatus {
	NEW
	IN_PROGRESS
	ACCEPTED
	DECLINED
}

enum TableOperationalStatus {
	AVAILABLE
	CLEANING
	OUT_OF_SERVICE
}

enum TableZone {
	SALLE
	TERRASSE
	BAR
	AUTRE
}

enum OrderStatus {
	OPEN
	SUBMITTED
	PREPARING
	READY
	SERVED
	PAID
	CANCELLED
}

enum OrderPaymentMethod {
	CASH
	CARD
	CHEQUE
	OTHER
}

model User {
	id                      String                   @id @default(cuid())
	email                   String                   @unique
	emailVerified           DateTime?
	passwordHash            String
	firstName               String
	lastName                String
	phone                   String?
	avatarUrl               String?
	avatarPublicId          String?
	dietaryPreferences      String[]
	role                    Role                     @default(CUSTOMER)
	isActive                Boolean                  @default(true)
	createdAt               DateTime                 @default(now())
	updatedAt               DateTime                 @updatedAt
	reservations            Reservation[]
	invoices                Invoice[]
	passwordResetTokens     PasswordResetToken[]
	emailVerificationTokens EmailVerificationToken[]
	specialOfferTargets     SpecialOfferTarget[]
	@@index([email])
	@@map("users")
}

model Admin {
	id                 String    @id @default(cuid())
	username           String    @unique
	passwordHash       String
	role               Role      @default(ADMIN)
	mustChangePassword Boolean   @default(true)
	lastLoginAt        DateTime?
	createdAt          DateTime  @default(now())
	updatedAt          DateTime  @updatedAt
	@@map("admins")
}

model MenuCategory {
	id          String   @id @default(cuid())
	name        String
	slug        String   @unique
	description String?
	iconName    String?
	order       Int      @default(0)
	isActive    Boolean  @default(true)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	dishes      Dish[]
	@@map("menu_categories")
}

model Image {
	id        String   @id @default(cuid())
	url       String
	publicId  String
	alt       String?
	isPrimary Boolean  @default(false)
	order     Int      @default(0)
	createdAt DateTime @default(now())

	dishId    String?
	dish      Dish?    @relation(fields: [dishId], references: [id], onDelete: Cascade)

	@@index([dishId])
	@@map("images")
}

model Dish {
	id              String             @id @default(cuid())
	categoryId      String
	name            String
	slug            String             @unique
	description     String?
	price           Float
	imageUrl        String?
	imagePublicId   String?
	allergens       String[]
	dietaryTags     String[]
	isAvailable     Boolean            @default(true)
	isDailySpecial  Boolean            @default(false)
	order           Int                @default(0)
	createdAt       DateTime           @default(now())
	updatedAt       DateTime           @updatedAt
	category        MenuCategory       @relation(fields: [categoryId], references: [id])
	images          Image[]
	specialOfferItems SpecialOfferItem[]
	orderItems      OrderItem[]
	@@index([categoryId])
	@@index([isAvailable])
	@@map("dishes")
}

model Reservation {
	id                  String            @id @default(cuid())
	userId              String?
	guestFirstName      String
	guestLastName       String
	guestEmail          String
	guestPhone          String
	date                DateTime          @db.Date
	timeSlot            String
	covers              Int
	notes               String?
	allergies           String?
	status              ReservationStatus @default(PENDING)
	cancellationReason  String?
	cancelledAt         DateTime?
	confirmedAt         DateTime?
	completedAt         DateTime?
	autoConfirmDeadline DateTime?
	createdAt           DateTime          @default(now())
	updatedAt           DateTime          @updatedAt
	user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
	payment             Payment?
	invoice             Invoice?
	tables              ReservationTable[]
	orders              Order[]
	@@index([date, status])
	@@index([userId])
	@@index([guestEmail])
	@@index([autoConfirmDeadline])
	@@map("reservations")
}

model RestaurantTable {
	id            String                  @id @default(cuid())
	number        String                  @unique
	name          String?
	capacity      Int
	zone          TableZone               @default(SALLE)
	status        TableOperationalStatus  @default(AVAILABLE)
	notes         String?
	isActive      Boolean                 @default(true)
	createdAt     DateTime                @default(now())
	updatedAt     DateTime                @updatedAt
	reservations  ReservationTable[]
	orders        OrderTable[]

	@@index([isActive, status])
	@@index([zone])
	@@map("restaurant_tables")
}

model ReservationTable {
	id           String         @id @default(cuid())
	reservationId String
	tableId      String
	assignedAt   DateTime       @default(now())
	releasedAt   DateTime?
	reservation  Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
	table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

	@@unique([reservationId, tableId])
	@@index([reservationId, releasedAt])
	@@index([tableId, releasedAt])
	@@map("reservation_tables")
}

model Order {
	id               String        @id @default(cuid())
	reservationId    String?
	guestFirstName   String?
	guestLastName    String?
	guestPhone       String?
	covers           Int           @default(1)
	status           OrderStatus   @default(OPEN)
	notes            String?
	subtotal         Float         @default(0)
	discountAmount   Float         @default(0)
	totalAmount      Float         @default(0)
	depositApplied  Float         @default(0)
	paidAmount      Float         @default(0)
	dueAmount        Float         @default(0)
	openedAt         DateTime      @default(now())
	servedAt         DateTime?
	paidAt           DateTime?
	cancelledAt      DateTime?
	createdAt        DateTime      @default(now())
	updatedAt        DateTime      @updatedAt
	reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
	items            OrderItem[]
	tables           OrderTable[]
	payments         OrderPayment[]

	@@index([status, openedAt])
	@@index([reservationId])
	@@map("orders")
}

model OrderTable {
	id        String         @id @default(cuid())
	orderId   String
	tableId   String
	assignedAt DateTime      @default(now())
	releasedAt DateTime?
	order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
	table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

	@@unique([orderId, tableId])
	@@index([tableId, releasedAt])
	@@index([orderId, releasedAt])
	@@map("order_tables")
}

model OrderItem {
	id          String   @id @default(cuid())
	orderId     String
	dishId      String?
	name        String
	unitPrice   Float
	quantity    Int
	lineTotal   Float
	notes       String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
	dish        Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

	@@index([orderId])
	@@index([dishId])
	@@map("order_items")
}

model OrderPayment {
	id          String              @id @default(cuid())
	orderId     String
	amount      Float
	method      OrderPaymentMethod
	reference   String?
	note        String?
	paidAt      DateTime            @default(now())
	createdAt   DateTime            @default(now())
	order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

	@@index([orderId, paidAt])
	@@map("order_payments")
}

model Payment {
	id                    String        @id @default(cuid())
	reservationId         String        @unique
	stripePaymentIntentId String?       @unique
	stripeChargeId        String?
	amount                Float
	currency              String        @default("eur")
	type                  PaymentType   @default(DEPOSIT)
	status                PaymentStatus @default(NONE)
	refundedAmount        Float?
	stripeRefundId        String?
	paidAt                DateTime?
	refundedAt            DateTime?
	failureReason         String?
	createdAt             DateTime      @default(now())
	updatedAt             DateTime      @updatedAt
	reservation           Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
	@@index([status])
	@@map("payments")
}

model Invoice {
	id            String      @id @default(cuid())
	invoiceNumber String      @unique
	reservationId String      @unique
	userId        String?
	guestEmail    String
	amount        Float
	taxAmount     Float       @default(0)
	totalAmount   Float
	pdfUrl        String?
	pdfPublicId   String?
	issuedAt      DateTime    @default(now())
	createdAt     DateTime    @default(now())
	updatedAt     DateTime    @updatedAt
	reservation   Reservation @relation(fields: [reservationId], references: [id])
	user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
	@@index([userId])
	@@map("invoices")
}

model SpecialOffer {
	id          String               @id @default(cuid())
	title       String
	description String?
	type        OfferType
	value       Float
	target      OfferTarget          @default(ALL)
	promoCode   String?              @unique
	minCovers   Int?
	isFirstOnly Boolean              @default(false)
	isPublic    Boolean              @default(true)
	startDate   DateTime
	endDate     DateTime
	isActive    Boolean              @default(true)
	createdAt   DateTime             @default(now())
	updatedAt   DateTime             @updatedAt
	items       SpecialOfferItem[]
	targets     SpecialOfferTarget[]
	@@map("special_offers")
}

model SpecialOfferItem {
	id             String       @id @default(cuid())
	specialOfferId String
	dishId         String
	specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)
	dish           Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
	@@unique([specialOfferId, dishId])
	@@map("special_offer_items")
}

model SpecialOfferTarget {
	id             String       @id @default(cuid())
	specialOfferId String
	userId         String
	specialOffer   SpecialOffer @relation(fields: [specialOfferId], references: [id], onDelete: Cascade)
	user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@unique([specialOfferId, userId])
	@@map("special_offer_targets")
}

model ScheduleDay {
	id        String   @id @default(cuid())
	dayOfWeek Int
	isOpen    Boolean  @default(true)
	slots     Json
	updatedAt DateTime @updatedAt
	@@unique([dayOfWeek])
	@@map("schedule_days")
}

model ClosedDay {
	id        String   @id @default(cuid())
	date      DateTime @db.Date
	reason    String?
	createdAt DateTime @default(now())
	@@unique([date])
	@@map("closed_days")
}

model GalleryImage {
	id         String          @id @default(cuid())
	imageUrl   String
	publicId   String
	caption    String?
	category   GalleryCategory @default(DISHES)
	order      Int             @default(0)
	isActive   Boolean         @default(true)
	uploadedAt DateTime        @default(now())
	@@map("gallery_images")
}

model EventRequest {
	id         String      @id @default(cuid())
	firstName  String
	lastName   String
	email      String
	phone      String
	eventType  String
	eventDate  DateTime?
	guestCount Int?
	budget     String?
	message    String
	status     EventStatus @default(NEW)
	adminNotes String?
	createdAt  DateTime    @default(now())
	updatedAt  DateTime    @updatedAt
	@@map("event_requests")
}

model AdminNotification {
	id        String   @id @default(cuid())
	type      String
	title     String
	message   String
	link      String?
	isRead    Boolean  @default(false)
	createdAt DateTime @default(now())
	@@map("admin_notifications")
}

model PasswordResetToken {
	id        String    @id @default(cuid())
	userId    String
	token     String    @unique
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime  @default(now())
	user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@map("password_reset_tokens")
}

model EmailVerificationToken {
	id        String    @id @default(cuid())
	userId    String
	token     String    @unique
	expiresAt DateTime
	usedAt    DateTime?
	createdAt DateTime  @default(now())
	user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
	@@map("email_verification_tokens")
}

model RestaurantSettings {
	id                      String   @id @default(cuid())
	name                    String   @default("Spoon")
	tagline                 String?
	description             String?
	logoUrl                 String?
	logoPublicId            String?
	phone                   String?
	email                   String?
	address                 String?
	googleMapsUrl           String?
	facebookUrl             String?
	instagramUrl            String?
	depositRequired         Boolean  @default(true)
	depositAmountPerCover   Float    @default(20.0)
	freeCancellationHours   Int      @default(24)
	maxCoversPerSlot        Int      @default(40)
	reservationDurationMinutes Int    @default(120)
	reservationGraceBeforeMinutes Int @default(30)
	minBookingNoticeHours   Int      @default(2)
	maxBookingAdvanceDays   Int      @default(60)
	autoConfirmReservations Boolean  @default(false)
	updatedAt               DateTime @updatedAt
	@@map("restaurant_settings")
}
